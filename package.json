{
  "name": "zombie-ne-spyat",
  "private": true,
  "version": "2.0.0",
  "description": "Волшебство только начинается — 3D-игра с управлением телом и руками через веб-камеру",
  "type": "module",
  "scripts": {
    "start": "python server.py",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:voice": "node --test tests/unit/voice-quality.test.js tests/unit/voice-spotter.test.js tests/unit/spell-phrase.test.js tests/unit/game-voices.test.js",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:py": "python -m unittest discover -s tests/python"
  },
  "devDependencies": {
    "peer": "1.0.2",
    "playwright": "1.56.1",
    "three": "^0.128.0"
  }
}
